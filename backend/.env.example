PORT=5000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/remitchain

# Secret used to sign the session JWT. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me

# Exact origin of the frontend. The server refuses to start without it
# because an unset value makes the CORS policy reflect any origin.
FRONTEND_URL=http://localhost:3000

# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# JSON array of 64 secret key bytes, printed by createWallet.ts
SOLANA_PRIVATE_KEY=[]
